# ============================================================
#  CMIOT AX18 云编译基础配置种子（lede 风格）
#  平台：qualcommax/ipq60xx，设备：cmiot_ax18，SOC：ipq6000
#  内核：6.12（由 target/linux/qualcommax/Makefile 决定）
#
#  说明：
#    - 该文件放在你 fork 的仓库根目录，workflow 会自动读取。
#    - 如需自定义固件包 / 内核选项，直接在这里增删即可。
#    - 请勿改动 CONFIG_TARGET_* 目标行，否则可能编错设备。
# ============================================================

# ---- 目标平台 / 子平台 / 设备 ----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y

# ---- 通用 ----
CONFIG_CCACHE=y                       # 启用 ccache 加速二次编译
CONFIG_KERNEL_BUILD_USER="pi"         # 内核构建信息（可选）
CONFIG_KERNEL_BUILD_DOMAIN="pi"       # 内核构建信息（可选）

# ---- LuCI（Web 管理界面）----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# ---- 常用工具（按需增删）----
# CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_nano=y
# CONFIG_PACKAGE_tcpdump=y
# CONFIG_PACKAGE_iperf3=y
# CONFIG_PACKAGE_nlbwmon=y
# CONFIG_PACKAGE_luci-app-ssr-plus=y      # 科学上网（依赖 helloworld feed）
# CONFIG_PACKAGE_luci-app-passwall=y      # 科学上网（依赖 helloworld feed）
